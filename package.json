{
  "name": "gscli",
  "version": "0.1.0",
  "description": "Google Search Console from the command line, built for AI agents and scripts",
  "license": "MIT",
  "author": "Anirudh Prakash",
  "type": "module",
  "bin": {
    "gscli": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "dev": "node src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "google-search-console",
    "search-console",
    "seo",
    "cli",
    "ai-agent",
    "claude",
    "llm"
  ],
  "private": true,
  "dependencies": {
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9"
  }
}
