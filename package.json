{
  "name": "gsc-agent-cli",
  "version": "0.2.0",
  "description": "Google Search Console from the command line, built for AI agents and scripts",
  "license": "MIT",
  "author": "Anirudh Prakash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anirudh-777/gscli.git"
  },
  "homepage": "https://github.com/anirudh-777/gscli#readme",
  "bugs": {
    "url": "https://github.com/anirudh-777/gscli/issues"
  },
  "type": "module",
  "bin": {
    "gscli": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "dev": "node src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "google-search-console",
    "search-console",
    "seo",
    "cli",
    "ai-agent",
    "claude",
    "llm"
  ],
  "dependencies": {
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
